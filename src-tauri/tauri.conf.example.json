{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web Security Hub",
  "version": "4.0.0",
  "identifier": "com.example.websecurityhub",
  "build": {
    "frontendDist": "../desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Web Security Hub",
        "width": 1440,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Web security testing and hands-on training",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/web-security-node"
    ],
    "resources": {
      "../.desktop/runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
