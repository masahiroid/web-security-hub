{
  "name": "web-security-hub",
  "version": "5.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Web Security Hub — OWASP-aligned dynamic web scanning and local static analysis.",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test",
    "postinstall": "playwright install chromium firefox webkit || true",
    "dynamic-scan": "node core/cli/securityScan.js",
    "autoflow": "node core/cli/autoflow.js",
    "replay": "node core/cli/replay.js",
    "training:start": "node training/sample-site/server.js",
    "training:setup": "node scripts/training.js setup",
    "training:mode": "node scripts/training.js",
    "training:verify": "node scripts/verify-training.js",
    "training:capture": "node scripts/capture-training.js",
    "launch": "node scripts/launch.js",
    "doctor": "node desktop/environment.js",
    "setup": "node desktop/environment.js --install",
    "desktop:config": "node scripts/desktop-config.js",
    "desktop:prepare": "node scripts/prepare-desktop.js",
    "desktop:dev": "node scripts/desktop.js dev",
    "desktop:build": "node scripts/desktop.js build",
    "desktop:verify": "node scripts/verify-desktop.js",
    "desktop:verify-layout": "node scripts/verify-desktop-layout.js",
    "release:check": "node scripts/check-release-content.js",
    "desktop:release:macos": "node scripts/release-macos.js",
    "desktop:sign:macos": "node scripts/sign-macos.js",
    "verifier:fixture": "node training/verifier-site/server.js",
    "verifier:test": "node --test test/verifier.test.js test/verifierHttpRunner.test.js test/verifierCampaign.test.js",
    "build:verifier": "tsc -p tsconfig.verifier.json && tsc -p tsconfig.server.json && tsc -p tsconfig.verifier-ui.json",
    "typecheck": "tsc -p tsconfig.verifier.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.verifier-ui.json --noEmit",
    "pretest": "npm run build:verifier",
    "preverifier:test": "npm run build:verifier",
    "preverifier:fixture": "npm run build:verifier",
    "verifier:run": "node core/verifier/generated/cli/verifier.js",
    "preverifier:run": "npm run build:verifier",
    "prestart": "npm run build:verifier",
    "prelaunch": "npm run build:verifier",
    "verifier:verify-ui": "node scripts/verify-verifier-ui.js",
    "verifier:verify-genetic-ui": "node scripts/verify-genetic-ui.js",
    "verifier:verify-vex-ui": "node scripts/verify-vex-ui.js",
    "preverifier:verify-ui": "npm run build:verifier",
    "sast:verify-ui": "node scripts/verify-sast-mapping-ui.js",
    "presast:verify-ui": "npm run build:verifier",
    "verifier:verify-zap": "node scripts/verify-verifier-zap.js",
    "preverifier:verify-zap": "npm run build:verifier",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "appium": "^3.7.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "playwright": "^1.64.1",
    "webdriverio": "10.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "appium-xcuitest-driver": "^12.18.3",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "basic-ftp": "6.2.3"
  }
}
